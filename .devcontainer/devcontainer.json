{
    "name": "Sams Docs Dev",
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    "features": {
        "ghcr.io/hamsamm/sams-devcontainers/lychee:1": {}
    },
    "customizations": {
        "codespaces": {
            "repositories": {
                "hamsamm/sams-devcontainers": {
                    "permissions": {
                        "packages": "read",
                        "contents": "read"
                    }
                }
            }
        },
        "vscode": {
            "extensions": [
                "davidanson.vscode-markdownlint",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "postCreateCommand": "lychee --version"
}